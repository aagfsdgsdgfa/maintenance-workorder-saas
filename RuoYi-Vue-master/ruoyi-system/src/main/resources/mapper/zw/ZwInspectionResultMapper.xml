<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.zw.mapper.ZwInspectionResultMapper">

    <resultMap type="com.ruoyi.zw.domain.ZwInspectionResult" id="ZwInspectionResultResult">
        <id property="resultId" column="result_id"/>
        <result property="taskId" column="task_id"/>
        <result property="pointId" column="point_id"/>
        <result property="assetId" column="asset_id"/>
        <result property="engineerId" column="engineer_id"/>
        <result property="checkItems" column="check_items"/>
        <result property="photoUrls" column="photo_urls"/>
        <result property="voiceText" column="voice_text"/>
        <result property="remark" column="remark"/>
        <result property="isNormal" column="is_normal"/>
        <result property="latitude" column="latitude"/>
        <result property="longitude" column="longitude"/>
        <result property="address" column="address"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectZwInspectionResultVo">
        select result_id, task_id, point_id, asset_id, engineer_id, check_items,
               photo_urls, voice_text, remark, is_normal, latitude, longitude, address,
               del_flag, create_by, create_time, update_by, update_time
        from zw_inspection_result
    </sql>

    <select id="selectZwInspectionResultList" resultMap="ZwInspectionResultResult">
        <include refid="selectZwInspectionResultVo"/>
        <where>
            <if test="taskId != null">and task_id = #{taskId}</if>
            <if test="assetId != null">and asset_id = #{assetId}</if>
            and del_flag = '0'
        </where>
        order by create_time desc
    </select>

    <select id="selectZwInspectionResultById" resultMap="ZwInspectionResultResult">
        <include refid="selectZwInspectionResultVo"/>
        where result_id = #{resultId} and del_flag = '0'
    </select>

    <select id="selectResultByTaskId" resultMap="ZwInspectionResultResult">
        <include refid="selectZwInspectionResultVo"/>
        where task_id = #{taskId} and del_flag = '0'
    </select>

    <select id="selectByEngineerAndDate" resultMap="ZwInspectionResultResult">
        <include refid="selectZwInspectionResultVo"/>
        where del_flag = '0'
          and engineer_id = #{engineerId}
          and date(create_time) = #{date}
        order by create_time asc
    </select>

    <insert id="insertZwInspectionResult" useGeneratedKeys="true" keyProperty="resultId">
        insert into zw_inspection_result
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskId != null">task_id,</if>
            <if test="pointId != null">point_id,</if>
            <if test="assetId != null">asset_id,</if>
            <if test="engineerId != null">engineer_id,</if>
            <if test="checkItems != null">check_items,</if>
            <if test="photoUrls != null">photo_urls,</if>
            <if test="voiceText != null">voice_text,</if>
            <if test="remark != null">remark,</if>
            <if test="isNormal != null">is_normal,</if>
            <if test="latitude != null">latitude,</if>
            <if test="longitude != null">longitude,</if>
            <if test="address != null">address,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskId != null">#{taskId},</if>
            <if test="pointId != null">#{pointId},</if>
            <if test="assetId != null">#{assetId},</if>
            <if test="engineerId != null">#{engineerId},</if>
            <if test="checkItems != null">#{checkItems},</if>
            <if test="photoUrls != null">#{photoUrls},</if>
            <if test="voiceText != null">#{voiceText},</if>
            <if test="remark != null">#{remark},</if>
            <if test="isNormal != null">#{isNormal},</if>
            <if test="latitude != null">#{latitude},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="address != null">#{address},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateZwInspectionResult">
        update zw_inspection_result
        <trim prefix="SET" suffixOverrides=",">
            <if test="checkItems != null">check_items = #{checkItems},</if>
            <if test="photoUrls != null">photo_urls = #{photoUrls},</if>
            <if test="voiceText != null">voice_text = #{voiceText},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="isNormal != null">is_normal = #{isNormal},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="address != null">address = #{address},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
        </trim>
        where result_id = #{resultId}
    </update>

    <update id="deleteZwInspectionResultByIds">
        update zw_inspection_result set del_flag = '2' where result_id in
        <foreach item="resultId" collection="array" open="(" separator="," close=")">
            #{resultId}
        </foreach>
    </update>

</mapper>
