<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.zw.mapper.ZwInspectionPlanMapper">

    <resultMap type="com.ruoyi.zw.domain.ZwInspectionPlan" id="ZwInspectionPlanResult">
        <id property="planId" column="plan_id"/>
        <result property="planName" column="plan_name"/>
        <result property="customerId" column="customer_id"/>
        <result property="customerName" column="customer_name"/>
        <result property="assetIds" column="asset_ids"/>
        <result property="frequencyType" column="frequency_type"/>
        <result property="frequencyCron" column="frequency_cron"/>
        <result property="assignedTo" column="assigned_to"/>
        <result property="engineerName" column="engineer_name"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectZwInspectionPlanVo">
        select p.plan_id, p.plan_name, p.customer_id, c.dept_name as customer_name,
               p.asset_ids, p.frequency_type, p.frequency_cron,
               p.assigned_to, u.nick_name as engineer_name,
               p.status, p.del_flag,
               p.create_by, p.create_time, p.update_by, p.update_time
        from zw_inspection_plan p
        left join sys_dept c on p.customer_id = c.dept_id
        left join sys_user u on p.assigned_to = u.user_id
    </sql>

    <select id="selectZwInspectionPlanList" resultMap="ZwInspectionPlanResult">
        <include refid="selectZwInspectionPlanVo"/>
        <where>
            <if test="planName != null and planName != ''">and p.plan_name like concat('%', #{planName}, '%')</if>
            <if test="customerId != null">and p.customer_id = #{customerId}</if>
            <if test="frequencyType != null and frequencyType != ''">and p.frequency_type = #{frequencyType}</if>
            <if test="assignedTo != null">and p.assigned_to = #{assignedTo}</if>
            <if test="status != null and status != ''">and p.status = #{status}</if>
            and p.del_flag = '0'
        </where>
        order by p.create_time desc
    </select>

    <select id="selectZwInspectionPlanById" resultMap="ZwInspectionPlanResult">
        <include refid="selectZwInspectionPlanVo"/>
        where p.plan_id = #{planId} and p.del_flag = '0'
    </select>

    <insert id="insertZwInspectionPlan" useGeneratedKeys="true" keyProperty="planId">
        insert into zw_inspection_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planName != null">plan_name,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="assetIds != null">asset_ids,</if>
            <if test="frequencyType != null">frequency_type,</if>
            <if test="frequencyCron != null">frequency_cron,</if>
            <if test="assignedTo != null">assigned_to,</if>
            <if test="status != null">status,</if>
            del_flag, create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planName != null">#{planName},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="assetIds != null">#{assetIds},</if>
            <if test="frequencyType != null">#{frequencyType},</if>
            <if test="frequencyCron != null">#{frequencyCron},</if>
            <if test="assignedTo != null">#{assignedTo},</if>
            <if test="status != null">#{status},</if>
            '0', now(),
        </trim>
    </insert>

    <update id="updateZwInspectionPlan">
        update zw_inspection_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="planName != null">plan_name = #{planName},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="assetIds != null">asset_ids = #{assetIds},</if>
            <if test="frequencyType != null">frequency_type = #{frequencyType},</if>
            <if test="frequencyCron != null">frequency_cron = #{frequencyCron},</if>
            <if test="assignedTo != null">assigned_to = #{assignedTo},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where plan_id = #{planId} and del_flag = '0'
    </update>

    <update id="deleteZwInspectionPlanByIds">
        update zw_inspection_plan set del_flag = '2' where plan_id in
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </update>

    <select id="selectActivePlans" resultMap="ZwInspectionPlanResult">
        select p.plan_id, p.plan_name, p.customer_id, p.asset_ids,
               p.frequency_type, p.frequency_cron, p.assigned_to, p.status,
               p.del_flag, p.create_by, p.create_time, p.update_by, p.update_time
        from zw_inspection_plan p
        where p.del_flag = '0' and p.status = '0'
    </select>

</mapper>
