<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.zw.mapper.ZwCustomerUserMapper">

    <resultMap type="com.ruoyi.zw.domain.ZwCustomerUser" id="ZwCustomerUserResult">
        <id property="custUserId" column="cust_user_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="userName" column="user_name"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="position" column="position"/>
        <result property="isPrimary" column="is_primary"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectZwCustomerUserVo">
        select cust_user_id, customer_id, user_name, phone, email, position,
               is_primary, del_flag, create_by, create_time, update_by, update_time
        from zw_customer_user
    </sql>

    <select id="selectZwCustomerUserList" resultMap="ZwCustomerUserResult">
        <include refid="selectZwCustomerUserVo"/>
        <where>
            <if test="customerId != null">and customer_id = #{customerId}</if>
            <if test="userName != null and userName != ''">and user_name like concat('%', #{userName}, '%')</if>
            <if test="phone != null and phone != ''">and phone = #{phone}</if>
            and del_flag = '0'
        </where>
        order by is_primary desc, create_time desc
    </select>

    <select id="selectZwCustomerUserById" resultMap="ZwCustomerUserResult">
        <include refid="selectZwCustomerUserVo"/>
        where cust_user_id = #{custUserId} and del_flag = '0'
    </select>

    <insert id="insertZwCustomerUser" useGeneratedKeys="true" keyProperty="custUserId">
        insert into zw_customer_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="customerId != null">customer_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="position != null">position,</if>
            <if test="isPrimary != null">is_primary,</if>
            del_flag, create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="customerId != null">#{customerId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="position != null">#{position},</if>
            <if test="isPrimary != null">#{isPrimary},</if>
            '0', now(),
        </trim>
    </insert>

    <update id="updateZwCustomerUser">
        update zw_customer_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="position != null">position = #{position},</if>
            <if test="isPrimary != null">is_primary = #{isPrimary},</if>
        </trim>
        where cust_user_id = #{custUserId} and del_flag = '0'
    </update>

    <update id="deleteZwCustomerUserByIds">
        update zw_customer_user set del_flag = '2' where cust_user_id in
        <foreach item="custUserId" collection="array" open="(" separator="," close=")">
            #{custUserId}
        </foreach>
    </update>

</mapper>
