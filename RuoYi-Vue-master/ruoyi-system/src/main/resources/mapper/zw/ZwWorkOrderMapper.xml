    <update id="updateZwWorkOrder" parameterType="com.ruoyi.zw.domain.ZwWorkOrder">
        update zw_work_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="priority != null and priority != ''">priority = #{priority},</if>
            <if test="assignedTo != null">assigned_to = #{assignedTo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="slaDeadline != null">sla_deadline = #{slaDeadline},</if>
            <if test="slaWarningSent != null">sla_warning_sent = #{slaWarningSent},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="contactAddress != null">contact_address = #{contactAddress},</if>
            <if test="acceptTime != null">accept_time = #{acceptTime},</if>
            <if test="serviceTime != null">service_time = #{serviceTime},</if>
            <if test="workOrderType != null">work_order_type = #{workOrderType},</if>
            <if test="faultDescription != null">fault_description = #{faultDescription},</if>
            <if test="faultCause != null">fault_cause = #{faultCause},</if>
            <if test="visitFee != null">visit_fee = #{visitFee},</if>
            <if test="serviceFee != null">service_fee = #{serviceFee},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="chargeStatus != null">charge_status = #{chargeStatus},</if>
            <if test="testStatus != null">test_status = #{testStatus},</if>
            <if test="customerSignUrl != null">customer_sign_url = #{customerSignUrl},</if>
            <if test="engineerSignUrl != null">engineer_sign_url = #{engineerSignUrl},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="completeTime != null">complete_time = #{completeTime},</if>
            <if test="signImage != null">sign_image = #{signImage},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
        </trim>
        where work_order_id = #{workOrderId}
    </update>

    <update id="deleteZwWorkOrderByIds">
        update zw_work_order set del_flag = '2' where work_order_id in
        <foreach item="workOrderId" collection="array" open="(" separator="," close=")">
            #{workOrderId}
        </foreach>
    </update>

    <select id="countToday" resultType="int">
        select count(*) from zw_work_order
        where del_flag = '0'
          and date(create_time) = curdate()
    </select>

    <select id="selectSlaPendingOrders" resultMap="ZwWorkOrderResult">
        <include refid="selectZwWorkOrderVo"/>
        where w.del_flag = '0'
          and w.status in ('0','1','2')
          and w.sla_warning_sent = 'N'
          and w.sla_deadline is not null
          and w.assigned_to is not null
    </select>

    <select id="selectMyTasks" resultMap="ZwWorkOrderResult">
        <include refid="selectZwWorkOrderVo"/>
        where w.del_flag = '0'
          and w.assigned_to = #{engineerId}
          <if test="status != null and status != ''">
            and w.status = #{status}
          </if>
          and w.status in ('0','1','2','3')
        order by
          case w.priority when '4' then 1 when '3' then 2 when '2' then 3 else 4 end,
          w.sla_deadline asc,
          w.create_time desc
    </select>

    <select id="selectByEngineerAndDate" resultMap="ZwWorkOrderResult">
        <include refid="selectZwWorkOrderVo"/>
        where w.del_flag = '0'
          and w.assigned_to = #{engineerId}
          and date(w.complete_time) = #{date}
        order by w.complete_time desc
    </select>

