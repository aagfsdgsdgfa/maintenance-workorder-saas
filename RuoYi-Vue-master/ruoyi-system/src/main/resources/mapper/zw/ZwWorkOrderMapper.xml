    <sql id="selectZwWorkOrderVo">
        select w.work_order_id, w.order_no, w.customer_id, w.asset_id, w.order_type, w.title,
               w.description, w.priority, w.assigned_to, w.assigned_by, w.status, w.sla_deadline,
               w.sla_warning_sent, w.contact_name, w.contact_phone, w.contact_address,
               w.accept_time, w.service_time, w.work_order_type,
               w.fault_description, w.fault_cause,
               w.visit_fee, w.service_fee, w.total_amount, w.charge_status,
               w.test_status, w.customer_sign_url, w.engineer_sign_url, w.remark,
               w.complete_time, w.sign_image, w.del_flag, w.create_by, w.create_time,
               w.update_by, w.update_time,
               c.dept_name as customer_name,
               a.asset_name, a.asset_code as serial_number,
               a.brand, a.model, a.purchase_date, a.asset_type,
               tc.start_date as contract_start_date, tc.end_date as contract_end_date
        from zw_work_order w
        left join sys_dept c on w.customer_id = c.dept_id
        left join zw_asset a on w.asset_id = a.asset_id and a.del_flag = '0'
        left join zw_contract tc on tc.customer_id = w.customer_id and tc.del_flag = '0' and tc.status = '0'
    </sql>

    <select id="selectZwWorkOrderList" parameterType="com.ruoyi.zw.domain.ZwWorkOrder" resultMap="ZwWorkOrderResult">
        <include refid="selectZwWorkOrderVo"/>
        <where>
            <if test="title != null and title != ''">
                and w.title like concat('%', #{title}, '%')
            </if>
            <if test="orderNo != null and orderNo != ''">
                and w.order_no = #{orderNo}
            </if>
            <if test="status != null and status != ''">
                and w.status = #{status}
            </if>
            <if test="statusList != null and statusList.size > 0">
                and w.status in
                <foreach collection="statusList" item="s" open="(" separator="," close=")">
                    #{s}
                </foreach>
            </if>
            <if test="priority != null and priority != ''">
                and w.priority = #{priority}
            </if>
            <if test="customerId != null">
                and w.customer_id = #{customerId}
            </if>
            <if test="assignedTo != null">
                and w.assigned_to = #{assignedTo}
            </if>
            <if test="createTimeStart != null and createTimeStart != ''">and date_format(w.create_time, '%Y-%m-%d') &gt;= #{createTimeStart}</if>
            <if test="createTimeEnd != null and createTimeEnd != ''">and date_format(w.create_time, '%Y-%m-%d') &lt;= #{createTimeEnd}</if>
            and w.del_flag = '0'
        </where>
        order by w.create_time desc
    </select>

    <select id="selectZwWorkOrderById" parameterType="Long" resultMap="ZwWorkOrderResult">
        <include refid="selectZwWorkOrderVo"/>
        where w.work_order_id = #{workOrderId} and w.del_flag = '0'
    </select>

    <select id="selectMaxOrderNo" resultType="String">
        select max(order_no) from zw_work_order where order_no like concat(#{datePrefix}, '%')
    </select>

