<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.zw.mapper.ZwContractMapper">

    <resultMap type="com.ruoyi.zw.domain.MaintenanceContract" id="MaintenanceContractResult">
        <id     property="contractId"          column="id"                   />
        <result property="contractNo"         column="contract_no"         />
        <result property="customerId"          column="customer_id"          />
        <result property="contractName"        column="contract_name"        />
        <result property="startDate"           column="start_date"           />
        <result property="endDate"            column="end_date"             />
        <result property="slaResponseHours"   column="sla_response_hours"   />
        <result property="slaArrivalHours"    column="sla_arrival_hours"    />
        <result property="includedInspections" column="included_inspections" />
        <result property="includedRepairs"    column="included_repairs"     />
        <result property="freePartsQuota"     column="free_parts_quota"     />
        <result property="extraVisitFee"      column="extra_visit_fee"      />
        <result property="discountRate"       column="discount_rate"        />
        <result property="attachmentUrl"      column="attachment_url"       />
        <result property="imageUrl"           column="image_url"            />
        <result property="status"             column="status"               />
        <result property="usedInspections"    column="used_inspections"     />
        <result property="usedRepairs"        column="used_repairs"         />
        <result property="usedPartsAmount"    column="used_parts_amount"    />
        <result property="delFlag"            column="del_flag"             />
        <result property="createBy"            column="create_by"           />
        <result property="createTime"         column="create_time"         />
        <result property="updateBy"            column="update_by"           />
        <result property="updateTime"         column="update_time"          />
    </resultMap>

    <sql id="selectMaintenanceContractVo">
        select id, contract_no, customer_id, contract_name, start_date, end_date,
               sla_response_hours, sla_arrival_hours, included_inspections, included_repairs,
               free_parts_quota, extra_visit_fee, discount_rate, attachment_url, image_url, status,
               used_inspections, used_repairs, used_parts_amount, del_flag,
               create_by, create_time, update_by, update_time
        from maintenance_contracts
    </sql>

    <select id="selectZwContractList" parameterType="com.ruoyi.zw.domain.MaintenanceContract" resultMap="MaintenanceContractResult">
        <include refid="selectMaintenanceContractVo"/>
        <where>
            <if test="contractNo != null and contractNo != ''">
                and contract_no = #{contractNo}
            </if>
            <if test="customerId != null">
                and customer_id = #{customerId}
            </if>
            <if test="contractName != null and contractName != ''">
                and contract_name like concat('%', #{contractName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            and del_flag = '0'
        </where>
        order by create_time desc
    </select>

    <select id="selectZwContractById" parameterType="Long" resultMap="MaintenanceContractResult">
        <include refid="selectMaintenanceContractVo"/>
        where id = #{contractId} and del_flag = '0'
    </select>

    <select id="selectZwContractByCustomerId" parameterType="Long" resultMap="MaintenanceContractResult">
        <include refid="selectMaintenanceContractVo"/>
        where customer_id = #{customerId} and del_flag = '0'
        order by create_time desc
    </select>

    <insert id="insertZwContract" parameterType="com.ruoyi.zw.domain.MaintenanceContract" useGeneratedKeys="true" keyProperty="contractId">
        insert into maintenance_contracts
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="contractNo != null and contractNo != ''">contract_no,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="contractName != null and contractName != ''">contract_name,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="slaResponseHours != null">sla_response_hours,</if>
            <if test="slaArrivalHours != null">sla_arrival_hours,</if>
            <if test="includedInspections != null">included_inspections,</if>
            <if test="includedRepairs != null">included_repairs,</if>
            <if test="freePartsQuota != null">free_parts_quota,</if>
            <if test="extraVisitFee != null">extra_visit_fee,</if>
            <if test="discountRate != null">discount_rate,</if>
            <if test="attachmentUrl != null and attachmentUrl != ''">attachment_url,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="status != null">status,</if>
            <if test="usedInspections != null">used_inspections,</if>
            <if test="usedRepairs != null">used_repairs,</if>
            <if test="usedPartsAmount != null">used_parts_amount,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="contractNo != null and contractNo != ''">#{contractNo},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="contractName != null and contractName != ''">#{contractName},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="slaResponseHours != null">#{slaResponseHours},</if>
            <if test="slaArrivalHours != null">#{slaArrivalHours},</if>
            <if test="includedInspections != null">#{includedInspections},</if>
            <if test="includedRepairs != null">#{includedRepairs},</if>
            <if test="freePartsQuota != null">#{freePartsQuota},</if>
            <if test="extraVisitFee != null">#{extraVisitFee},</if>
            <if test="discountRate != null">#{discountRate},</if>
            <if test="attachmentUrl != null and attachmentUrl != ''">#{attachmentUrl},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="usedInspections != null">#{usedInspections},</if>
            <if test="usedRepairs != null">#{usedRepairs},</if>
            <if test="usedPartsAmount != null">#{usedPartsAmount},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateZwContract" parameterType="com.ruoyi.zw.domain.MaintenanceContract">
        update maintenance_contracts
        <set>
            <if test="contractNo != null and contractNo != ''">contract_no = #{contractNo},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="contractName != null and contractName != ''">contract_name = #{contractName},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="slaResponseHours != null">sla_response_hours = #{slaResponseHours},</if>
            <if test="slaArrivalHours != null">sla_arrival_hours = #{slaArrivalHours},</if>
            <if test="includedInspections != null">included_inspections = #{includedInspections},</if>
            <if test="includedRepairs != null">included_repairs = #{includedRepairs},</if>
            <if test="freePartsQuota != null">free_parts_quota = #{freePartsQuota},</if>
            <if test="extraVisitFee != null">extra_visit_fee = #{extraVisitFee},</if>
            <if test="discountRate != null">discount_rate = #{discountRate},</if>
            <if test="attachmentUrl != null and attachmentUrl != ''">attachment_url = #{attachmentUrl},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="usedInspections != null">used_inspections = #{usedInspections},</if>
            <if test="usedRepairs != null">used_repairs = #{usedRepairs},</if>
            <if test="usedPartsAmount != null">used_parts_amount = #{usedPartsAmount},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
        </set>
        where id = #{contractId}
    </update>

    <update id="deleteZwContractByIds">
        update maintenance_contracts set del_flag = '2' where id in
        <foreach item="contractId" collection="array" open="(" separator="," close=")">
            #{contractId}
        </foreach>
    </update>

</mapper>
